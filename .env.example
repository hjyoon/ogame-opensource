# Copy this file to .env. Docker Compose reads the root .env automatically.
# Replace every change-me value before exposing the service.

# Public ports and URLs
OGAME_GO_PORT=8890
OGAME_SQLITE_PORT=8891
OGAME_SQLITE_VOLUME=ogame-opensource_sqlite_data
OGAME_LEGACY_PORT=8888
OGAME_MYSQL_PORT=3306
OGAME_MAILHOG_PORT=8026
OGAME_PHPMYADMIN_PORT=8080
OGAME_LEGACY_BASE_URL=http://localhost:8888
# MySQL Go Compose default: http://localhost:8890
# SQLite Compose default: http://localhost:8891
# Set a public non-loopback URL in production; loopback defaults use the signup request origin for activation links.
# OGAME_PUBLIC_BASE_URL=https://ogame.example.com
OGAME_PUBLIC_BASE_URL=
OGAME_PUBLIC_UNIVERSES=

# Go runtime (native runs use all of these; Compose fixes the listen address)
OGAME_ENV=development
OGAME_LOG_LEVEL=info
# IANA timezone used by both the legacy PHP and Go application servers.
OGAME_TIMEZONE=Europe/Moscow
OGAME_HTTP_ADDR=:8080
OGAME_STATIC_DIR=frontend/dist
OGAME_LEGACY_ASSET_DIR=download
OGAME_LEGACY_GAME_DIR=game

# Database mode: mysql or sqlite. The goapp-sqlite service always selects sqlite.
OGAME_DB_DRIVER=mysql
OGAME_MASTER_DB_ENABLE=1
OGAME_UNI_DB_ENABLE=1
OGAME_UNI_NUMBER=1
OGAME_UNI_DB_PREFIX=uni1_
OGAME_UNI_DB_SECRET=change-me
OGAME_DB_MAX_OPEN_CONNS=25
OGAME_DB_MAX_IDLE_CONNS=5
OGAME_DB_CONN_MAX_LIFETIME_SECONDS=1800
# Due game queues are atomically settled in the background. Set 0 to disable.
OGAME_QUEUE_POLL_INTERVAL_MS=1000

# MySQL
MYSQL_ROOT_PASSWORD=change-me
OGAME_MDB_HOST=mysql
OGAME_MDB_USER=root
OGAME_MDB_PASS=change-me
OGAME_MDB_NAME=master
OGAME_UNI_DB_HOST=mysql
OGAME_UNI_DB_USER=root
OGAME_UNI_DB_PASS=change-me
OGAME_UNI_DB_NAME=uni

# SQLite native paths. SQLite Compose uses persistent /srv/ogame/data files.
OGAME_SQLITE_MASTER_PATH=data/ogame-master.sqlite
OGAME_SQLITE_UNIVERSE_PATH=data/ogame-universe.sqlite
OGAME_SQLITE_AUTO_MIGRATE=1

# Initial admin. SQLite seeds these only when the account does not exist.
OGAME_ADMIN_EMAIL=admin@example.local
OGAME_ADMIN_PASSWORD=change-me

# SMTP. Keep OGAME_SMTP_ENABLE blank to use each Compose mode's default.
# OGAME_SMTP_ENABLE=1
OGAME_SMTP_ENABLE=
OGAME_SMTP_ADDR=mailhog:1025
OGAME_SMTP_FROM=OGame <noreply@localhost>

# MCP, OAuth, OIDC, and rate limits
OGAME_MCP_STATIC_TOKENS=
OGAME_MCP_OAUTH_REDIRECT_URIS=
OGAME_MCP_OIDC_ED25519_SEED_B64=
OGAME_MCP_OIDC_ED25519_PREVIOUS_SEEDS_B64=
OGAME_MCP_TOKEN_TTL_SECONDS=2592000
OGAME_MCP_RATE_LIMIT_ENABLE=1
OGAME_MCP_RATE_LIMIT_PER_MINUTE=300
OGAME_MCP_RATE_LIMIT_BURST=60

# Legacy PHP automatic installation
OGAME_AUTO_INSTALL=1
OGAME_UNI_AUTO_INSTALL=1
OGAME_UNI_URL=localhost:8888
OGAME_STARTPAGE=http://localhost:8888
OGAME_UNI_MDB_ENABLE=1
OGAME_UNI_NUM=1
OGAME_UNI_LANG=en
OGAME_UNI_SPEED=1
OGAME_UNI_FLEET_SPEED=1
OGAME_UNI_GALAXIES=9
OGAME_UNI_SYSTEMS=499
OGAME_UNI_MAX_USERS=12500
OGAME_UNI_START_DM=0
OGAME_UNI_ACS=4
OGAME_UNI_FID=30
OGAME_UNI_DID=0
OGAME_UNI_RAPID=1
OGAME_UNI_MOONS=1
OGAME_UNI_BATTLE_ENGINE=../cgi-bin/battle
OGAME_UNI_PHP_BATTLE=1
OGAME_UNI_BATTLE_MAX=1000000
OGAME_UNI_FORCE_LANG=0
OGAME_UNI_MAX_WERF=999
OGAME_UNI_FEED_AGE=60
OGAME_EXT_BOARD=
OGAME_EXT_DISCORD=
OGAME_EXT_TUTORIAL=
OGAME_EXT_RULES=
OGAME_EXT_IMPRESSUM=
